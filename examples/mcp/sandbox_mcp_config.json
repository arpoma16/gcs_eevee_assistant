{
  "sandbox": {
    "type": "container",
    "image": "python:3.12-slim",
    "working_dir": "/workspace",
    "allow_network": false,
    "mounts": [
      {
        "source": "${GCS_EEVEE_ROOT}",
        "target": "/workspace",
        "read_only": false
      }
    ],
    "allowed_commands": [
      "python",
      "python3"
    ]
  },
  "mcp_servers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/workspace"
      ]
    }
  }
}
