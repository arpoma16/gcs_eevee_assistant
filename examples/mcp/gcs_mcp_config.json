{
  "mcp_servers": {
    "multiuav_gcs": {
      "type": "http",
      "url": "${GCS_MCP_URL}",
      "headers": {
        "Authorization": "Bearer ${GCS_MCP_TOKEN}"
      }
    },
    "multiuav_gcs_local_dev": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "tsx", "${MCP_SERVER_SRC}/index.ts", "stdio"],
      "env": {
        "MUAV_API_URL": "${MUAV_API_URL}",
        "MUAV_API_TOKEN": "${MUAV_API_TOKEN}"
      }
    }
  }
}
