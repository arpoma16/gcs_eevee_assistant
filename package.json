{
  "name": "gcs-eevee-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "agents/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @gcs/assistant",
    "dev:assistant": "npm run dev -w @gcs/assistant",
    "build": "npm run build -w @gcs/assistant",
    "start": "npm run start -w @gcs/assistant",
    "eval": "npm run eval -w @gcs/assistant",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": "24.x"
  }
}
